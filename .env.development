# Local dev only (npm run dev). Matches the credentials in .env.example used by `npm run deps:up`.
DATABASE_URL=postgres://app:change-me@localhost:5432/app
REDIS_URL=redis://:change-me@localhost:6379
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=uploads
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too
LOG_LEVEL=debug
DEBUG_ROUTES=true
