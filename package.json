{
  "name": "bm-test",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/index.js",
    "dev": "tsx watch --env-file=.env.development src/index.ts | pino-pretty",
    "dev:web": "npm --prefix web run dev",
    "deps:up": "docker compose -f infra/compose.yml -f infra/compose.dev.yml --env-file .env.example up -d postgres redis s3",
    "deps:down": "docker compose -f infra/compose.yml -f infra/compose.dev.yml --env-file .env.example stop postgres redis s3",
    "stack:up": "docker compose -f infra/compose.yml -f infra/compose.dev.yml --env-file .env.example up -d --build",
    "stack:down": "docker compose -f infra/compose.yml -f infra/compose.dev.yml --env-file .env.example down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@fastify/multipart": "^10.1.6",
    "@sentry/node": "^11.10.0",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
