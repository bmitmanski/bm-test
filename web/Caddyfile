{
	# The edge Caddy sits in front: trust its X-Forwarded-For so the visitor's IP is passed on.
	servers {
		trusted_proxies static private_ranges
	}
}

# Serves the built SPA inside the web container. TLS is handled by the edge Caddy.
:80 {
	encode zstd gzip

	# Sentry tunnel: browser events go through our own domain, so ad blockers don't drop them.
	# Forwards to one Sentry project only; the target is generated from the DSN at build time (see Dockerfile).
	@sentry {
		method POST
		path /sentry-tunnel
	}
	handle @sentry {
		request_body {
			max_size 1MB
		}
		import /etc/caddy/sentry-tunnel.caddy
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
