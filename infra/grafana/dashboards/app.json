    {
      "type": "timeseries",
      "title": "Event loop lag (p99)",
      "description": "Grows when something blocks the Node.js thread",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "nodejs_eventloop_lag_p99_seconds{job=\"app\"}",
