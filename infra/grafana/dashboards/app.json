    {
      "type": "timeseries",
      "title": "Errors: 4xx vs 5xx vs frontend (per minute)",
      "description": "4xx = client mistake (usually fine), 5xx = server error (alert), frontend = window.onerror",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (class) (rate(http_errors_total{env=\"$env\"}[1m])) * 60",
          "legendFormat": "{{class}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(frontend_errors_total{env=\"$env\"}[1m])) * 60",
          "legendFormat": "frontend"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
