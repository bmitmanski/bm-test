{
	email {$ACME_EMAIL}
}

# Caddy fetches and renews Let's Encrypt certs automatically once DNS points here.
{$DOMAIN} {
	encode zstd gzip

	# Prometheus metrics are for the internal network only.
	handle /api/metrics {
		respond 404
	}

	# Same origin for FE and API: no CORS, one certificate.
	handle_path /api/* {
		reverse_proxy app:3000
	}

	handle {
		reverse_proxy web:80
	}
}

# Basic auth in front of Grafana's own login: bots and password-guessers never reach Grafana.
grafana.{$DOMAIN} {
	basic_auth {
		admin {$GRAFANA_BASIC_AUTH_HASH}
	}
	reverse_proxy grafana:3000 {
		# The browser keeps sending the basic-auth header; Grafana would treat it as its own login and reject it.
		header_up -Authorization
	}
}
