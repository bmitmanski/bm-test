# Copy to infra/.env on the VPS (never commit the real one).
DOMAIN=localhost
ACME_EMAIL=you@example.com

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

REDIS_PASSWORD=change-me

S3_BUCKET=uploads
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too

GRAFANA_ADMIN_PASSWORD=change-me

LOG_LEVEL=info

# Test endpoints that deliberately fail (UI "Testowe awarie"). Keep false for real users.
DEBUG_ROUTES=true

# Grafana alerts: recipient (defaults to ACME_EMAIL) and SMTP for sending.
# Gmail: SMTP_HOST=smtp.gmail.com:587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<app password>
ALERT_EMAIL=
SMTP_ENABLED=false
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Sentry DSN of the API project (Project settings → Client Keys). Empty = disabled.
# The frontend DSN is a GitHub variable (SENTRY_DSN_WEB), baked in at build time.
SENTRY_DSN=
